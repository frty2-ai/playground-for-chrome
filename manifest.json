{
  "manifest_version": 3,
  "name": "Frty2 Guide for Zoho CRM",
  "version": "0.8.1",
  "description": "Frty2 inside the application: a ghost cursor that teaches learners in their own Zoho CRM, Watch, which records an expert using an app while they explain it, and a live voice tutor in any app.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "activeTab",
    "scripting",
    "offscreen",
    "tts",
    "tabCapture"
  ],
  "host_permissions": [
    "https://*.zoho.in/*",
    "https://*.zoho.com/*",
    "https://*.zoho.eu/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.wawm.ai/*",
    "https://*.vercel.app/*",
    "https://*.trycloudflare.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Frty2 Guide"
  },
  "commands": {
    "watch-toggle": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Start or stop watching this tab"
    },
    "watch-step": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Watch: mark the start of a step"
    },
    "watch-private": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Watch: pause while something private is on screen, or resume"
    },
    "watch-mistake": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Watch: that was a mistake, drop the last 10 seconds (undo)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.zoho.in/*",
        "https://crm.zoho.com/*",
        "https://crm.zoho.eu/*",
        "https://crmsandbox.zoho.in/*",
        "https://crmsandbox.zoho.com/*"
      ],
      "js": [
        "vendor/fira-code-nerd/fira-code-nerd.js",
        "brand.js",
        "ghost.js"
      ],
      "css": [
        "ghost.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.wawm.ai/*",
        "https://*.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
